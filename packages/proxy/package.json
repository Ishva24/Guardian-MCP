{
  "name": "@guardian-mcp/proxy",
  "version": "1.0.0",
  "description": "Guardian-MCP zero-trust intercepting proxy",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --loader ts-node/esm src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "keygen": "node --loader ts-node/esm src/scripts/keygen.ts",
    "token": "node --loader ts-node/esm src/scripts/issue-token.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^4.27.0",
    "jose": "^5.3.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.1.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
